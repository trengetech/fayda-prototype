{
  "name": "fayda",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": { "node": ">=24.3.0" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @fayda/api db:migrate",
    "graph": "GRAPHIFY_BACKEND=none graphify extract . --code-only --force --allow-dedup-shrink && GRAPHIFY_BACKEND=none graphify cluster-only . --no-label --no-viz",
    "graph:update": "GRAPHIFY_BACKEND=none graphify update ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "@swc/core", "@nestjs/core"] }
}
