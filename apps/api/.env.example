# Copy to .env (development) or .env.test (tests). Never commit real values.
# Runtime API connection: Supabase transaction pooler, port 6543.
DATABASE_URL=
# Migrations: Supabase session pooler, port 5432.
DATABASE_URL_DIRECT=
# Signs access tokens: 32+ random characters.
JWT_SECRET=
# Optional (defaults shown)
# PORT=3000
# HOST=127.0.0.1
# CORS_ORIGINS=
# SWEEP_ENABLED=true
# APP_ENV=development   # label shown by /v1/meta; defaults to NODE_ENV
# AUTH_PROVIDER=dev-otp
# ACCESS_TTL_SECONDS=900
# REFRESH_TTL_DAYS=90
# AUTH_RATE_LIMIT_PER_MIN=20
# UPLOADS_DIR=./uploads   # local-disk media; on the VM use /var/lib/fayda/uploads (outside the release folders)
# PUSH_PROVIDER=off        # off = nothing is sent (shown as simulated); expo = send through the Expo push service (Android + iOS)
# EXPO_ACCESS_TOKEN=       # only if the Expo project requires an access token for push
