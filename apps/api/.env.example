# Copy to .env (development) or .env.test (tests). Never commit real values.
# Runtime API connection: Supabase transaction pooler, port 6543.
DATABASE_URL=
# Migrations: Supabase session pooler, port 5432.
DATABASE_URL_DIRECT=
# Signs access tokens: 32+ random characters. Generate with: openssl rand -base64 48
# Use a different value for .env, .env.test and every server; never reuse one. See docs/SYSTEM_OVERVIEW.md section 11.
JWT_SECRET=
# Optional (defaults shown)
# PORT=3000
# HOST=127.0.0.1
# CORS_ORIGINS=
# SWEEP_ENABLED=true
# Comment counts on cards and product pages: all (default, everyone counted) or viewer (leaves out people the viewer blocked)
# COMMENT_COUNT_MODE=all
# For You order: scored (ranking score, I-39) or newest (the fallback). Switch back with no code change.
# FEED_RANKER=scored
# The oldest app contract level each app may use. Older apps get 426 CLIENT_TOO_OLD and a "please update" screen. Raise it only when an old app can no longer work.
# MIN_CLIENT_LEVEL_BUYER=1
# MIN_CLIENT_LEVEL_SELLER=1
# APP_ENV=development   # label shown by /v1/meta; defaults to NODE_ENV
# AUTH_PROVIDER=dev-otp
# ACCESS_TTL_SECONDS=900
# REFRESH_TTL_DAYS=90
# AUTH_RATE_LIMIT_PER_MIN=20
# UPLOADS_DIR=./uploads   # local-disk media; on the VM use /var/lib/fayda/uploads (outside the release folders)
# PUSH_PROVIDER=off        # off = nothing is sent (shown as simulated); expo = send through the Expo push service (Android + iOS)
# EXPO_ACCESS_TOKEN=       # only if the Expo project requires an access token for push
