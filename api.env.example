# Template for /etc/fayda/api.env on the API server (the Oracle VM). Names and example values only: NO real secrets here.
# The real file is created by hand over SSH, is never committed, and is read by the fayda-api systemd unit
# (EnvironmentFile=/etc/fayda/api.env). infra/deploy-api.sh never touches it.
#
# Create it once:
#   sudo install -m 640 -o root -g ubuntu /dev/null /etc/fayda/api.env
#   sudo nano /etc/fayda/api.env        # paste the lines below with real values
#   sudo systemctl restart fayda-api    # after any change
#
# Keep the real values somewhere safe (a password manager): they exist only on the VM. A new JWT_SECRET signs everyone out.

# Postgres: the Supabase transaction pooler (port 6543). Migrations use a different URL and run from the laptop, not here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Signs access tokens. 32 or more random characters. Generate it ON THE SERVER, never type one, never reuse another environment's:
#   echo "JWT_SECRET=$(openssl rand -base64 48 | tr -d '\n')" | sudo tee -a /etc/fayda/api.env >/dev/null
# (Full procedure and what happens if it changes: docs/SYSTEM_OVERVIEW.md, section 11.)
JWT_SECRET=

# The label /v1/meta reports: development, test or production.
APP_ENV=development

# Where uploaded photos, videos and QR images are kept. Must be outside the release folders (a deploy replaces those).
UPLOADS_DIR=/var/lib/fayda/uploads

# Push notifications: off = nothing is sent (reported as simulated); expo = send through the Expo push service (Android and iOS).
PUSH_PROVIDER=off

# Comment counts on cards and product pages: all = everyone counted (default); viewer = leaves out people the viewer has blocked.
COMMENT_COUNT_MODE=all

# The oldest app contract level each app may use (see CONTRACT_LEVEL in packages/contracts/src/system.ts). Older apps get 426 and a "please update" screen.
MIN_CLIENT_LEVEL_BUYER=1
MIN_CLIENT_LEVEL_SELLER=1

# Optional, only if the Expo project turns on enhanced push security. Leave unset otherwise.
# EXPO_ACCESS_TOKEN=

# Other optional settings and their defaults are listed in apps/api/.env.example (PORT and NODE_ENV are set by the systemd unit).
